# EFZ Web Application - Microsoft SQL Server Database Configuration Template
# Copy this file to .env and configure your local environment settings

# Microsoft SQL Server Connectivity
DB_SERVER=LAPTOP-N6BLB75S
DB_DATABASE=EFZApp
DB_USER=sa
DB_PASSWORD=your_secure_db_password
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# API Server Port & Network
PORT=5050
CORS_ORIGIN=http://localhost:3000

# Database Backup Directory for dbo.DbBackup
DB_BACKUP_DIRECTORY=C:\DbBackup

# JWT Authentication Signing Secret (minimum 32 characters, e.g. 64-character random hex string)
AUTH_TOKEN_SECRET=replace_with_a_cryptographically_secure_random_string_at_least_32_characters_long

# Operator User Accounts (JSON Array with scrypt password hashes)
# Password hashes can be generated via: npm run auth:hash -- "your-password"
AUTH_USERS_JSON='[{"id":"OP-ADMIN-01","name":"Francis Zaragosa","email":"admin@efzdavao.ph","role":"admin","roleTitle":"Store Manager & Administrator","entityLabel":"Executive Management","workstation":"MGMT-TERM-01","avatar":"FZ","passwordHash":"scrypt$..."},{"id":"OP-CASH-01","name":"Maria Elena Santos","email":"cashier@efzdavao.ph","role":"cashier","roleTitle":"Sales Specialist & Cashier","entityLabel":"Front-Counter Sales","workstation":"POS-COUNTER-01","avatar":"MS","passwordHash":"scrypt$..."},{"id":"OP-INV-01","name":"Danilo Cruz","email":"inventory@efzdavao.ph","role":"inventory","roleTitle":"Warehouse & Procurement Specialist","entityLabel":"Supply Chain & Warehouse","workstation":"WAR-TERM-01","avatar":"DC","passwordHash":"scrypt$..."},{"id":"OP-TECH-01","name":"Kenneth Bautista","email":"technician@efzdavao.ph","role":"technician","roleTitle":"Senior RMA & Warranty Technician","entityLabel":"Service Center & Diagnostics","workstation":"RMA-BENCH-01","avatar":"KB","passwordHash":"scrypt$..."}]'
