# EFZ Web Application - Frontend Environment Configuration Template
# Copy this file to .env.local or .env to configure frontend settings

# Optional API Base URL. Leave empty to use Vite reverse proxy (/api -> http://localhost:5050)
VITE_API_BASE_URL=

# Offline Demo Mode: Set to 'true' in DEV to allow localStorage fallback if backend API is unreachable
VITE_ENABLE_OFFLINE_DEMO=false
